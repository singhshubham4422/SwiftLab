# ==============================================================================
# SwiftLab Inventory & Billing Platform - Environment Configuration Template
# ==============================================================================
# IMPORTANT:
# - Copy this file to .env for local testing if needed.
# - NEVER commit real production credentials or .env files to Git.
# - For Render cloud deployment, set these variables in the Render Dashboard under Environment.
# - The Thymeleaf web application is served directly by Spring Boot on Render.
# - SUPABASE_SERVICE_ROLE_KEY is strictly server-side (Render only) and must NEVER
#   be embedded or exposed to browser JavaScript, Android APK, or Windows desktop clients.
# ==============================================================================

# Application Profile: 'local' (offline H2 file DB) or 'cloud' (Supabase PostgreSQL)
SPRING_PROFILES_ACTIVE=local

# Server Port (Render sets the PORT variable automatically; default is 8080)
PORT=8080

# ------------------------------------------------------------------------------
# Supabase Database Configuration (Required for 'cloud' profile on Render)
# ------------------------------------------------------------------------------
# In Supabase: Project Settings -> Database -> Connection string (JDBC / URI)
DATABASE_URL=jdbc:postgresql://db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_supabase_db_password

# ------------------------------------------------------------------------------
# Supabase REST / Storage Secrets (Used server-side by Spring Boot)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
# CRITICAL: Keep server-side only in Render. NEVER expose to Android or Web client.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ------------------------------------------------------------------------------
# Application Runtime & Sync Settings
# ------------------------------------------------------------------------------
# Initial data mode on startup: LOCAL_ONLY or CLOUD_SYNC
APP_DEFAULT_MODE=LOCAL_ONLY

# Security & API Token Signing Secret (Minimum 32 characters for HMAC-SHA256)
APP_JWT_SECRET=your-secure-random-32-character-secret-key-here-12345

# Device Identifier (Optional override; auto-generated if omitted)
APP_DEVICE_NAME=SwiftLab Workstation

# Production Cloud API URL (Used by Android app / desktop client when connecting to Render)
APP_CLOUD_API_URL=https://swiftlab-platform.onrender.com
